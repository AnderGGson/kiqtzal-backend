# Puerto HTTP del backend
PORT=3001

# Driver de base de datos: 'memory' (desarrollo sin instalar nada) | 'postgres' (producción)
DATABASE_DRIVER=memory

# Obligatorio cuando DATABASE_DRIVER=postgres (ej. Neon). Solo PostgreSQL está soportado.
# DATABASE_URL=postgresql://usuario:clave@host:5432/kiqtzal

# Neon requiere TLS normalmente: ponlo en 'true' en producción.
# DATABASE_SSL=true

# Opcional: si quieres que este backend sirva el frontend compilado (un solo servicio).
# Ruta relativa al build de Vite desde la carpeta del backend.
# WEB_DIST=../kiqtzal-frontend/dist